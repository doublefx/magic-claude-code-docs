{
  "name": "magic-claude-docs",
  "version": "2026.9.10.2",
  "description": "Community mirror of Claude Code documentation - search, browse, and view what's new offline",
  "author": {
    "name": "doublefx",
    "url": "https://github.com/doublefx"
  },
  "homepage": "https://github.com/doublefx/magic-claude-code-docs",
  "repository": "https://github.com/doublefx/magic-claude-code-docs",
  "license": "MIT",
  "keywords": [
    "documentation",
    "claude-code",
    "docs",
    "reference",
    "offline"
  ],
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/sync-docs.sh\""
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/version-signal.sh\""
          }
        ]
      }
    ]
  }
}
